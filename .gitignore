# Resume cache for the QPL crawler (regenerable, large JSONL).
data/.cache/

# Generated extraction debug images (huge, regenerable)
**/debug/
**/chrome-validation-profile-*/
**/validation-downloads-*/

# --- Legacy directories replaced by the simpler layout ---
# Source-of-truth is now `app/`; `app_static/` is obsolete and should stay out
# of future commits.
app_static/
text/
data/svg/

# Duplicate of MIL-DTL-38999-dtl38999.pdf; keep only the canonical name.
docs/pdfs/specs/dtl38999.pdf
# Large generated datasets are checked in as size-bounded shard directories
# (data/<name>/index.json + <array>_NNN.json, each < 50 MiB) rather than as one
# monolithic file. Ignore only the legacy single-file form so a stray rebuild of
# the old layout is never committed; the data/<name>/ shard dirs ARE tracked.
# Regenerate the shards with: python scripts/build_valid_d38999_pns.py
data/environment/d38999_environment_classification.json
data/part_numbers/d38999_valid_part_numbers.json
# app/app-data.js is a pure build artifact rebuilt from data/ by scripts/build_app.py
# (CI/Pages regenerates it on every push), so it is intentionally not committed.
app/app-data.js
app/data/d38999_valid_part_numbers.json

# Derived converter exports regenerated from scripts/d38999_rules.py by
# scripts/build_d38999_database.py. They have no app/CLI consumer (the bundle
# embeds rules straight from d38999_rules.py), so they are not committed.
# example_conversions.csv IS committed because the smoke test consumes it.
data/converter/d38999_cross_reference.sqlite
data/converter/style_mappings.csv
data/converter/finish_mappings.csv
data/rules/conversion_rules.csv
data/rules/rule_constraints.csv
